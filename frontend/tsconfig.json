{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "strict": false,
    "noImplicitAny": false,
    "moduleResolution": "bundler",
    "types": ["svelte", "vite/client"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.svelte",
    "wailsjs/**/*.js",
    "wailsjs/**/*.ts"
  ]
}
